# ============================================
# Resume CLI 环境变量配置
# ============================================
# 使用方式: 复制此文件为 .env 并填写配置
#   cp .env.example .env
#
# 程序启动时会自动读取项目根目录的 .env，不必再 export。
# 已存在的环境变量优先于 .env。
# 下面的 sk-your-api-key-here 只是占位符，不替换会被视为未配置。
# ============================================

# OpenAI API 配置
# 必填: OpenAI API Key（或其他兼容接口的 Key）
OPENAI_API_KEY=sk-your-api-key-here

# API 基础地址（默认 OpenAI 官方）
# 如果使用第三方兼容接口，修改为对应地址
# 例如: https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型名称（默认 gpt-4o-mini）
# 可选: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, deepseek-chat 等
OPENAI_MODEL=gpt-4o-mini

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# API 请求超时时间（秒，整数）
REQUEST_TIMEOUT=60
