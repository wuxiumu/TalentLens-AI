# ============================================
# Resume CLI 环境变量配置
# ============================================
# 使用方式: 复制此文件为 .env 并填写配置
#   cp .env.example .env
#   export $(cat .env | xargs)
# ============================================

# OpenAI API 配置
# 必填: OpenAI API Key（或其他兼容接口的 Key）
OPENAI_API_KEY=sk-your-api-key-here

# API 基础地址（默认 OpenAI 官方）
# 如果使用第三方兼容接口，修改为对应地址
# 例如: https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型名称（默认 gpt-4o-mini）
# 可选: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, deepseek-chat 等
OPENAI_MODEL=gpt-4o-mini

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO

# API 请求超时时间（秒）
REQUEST_TIMEOUT=60
